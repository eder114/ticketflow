# Copiar este archivo como .env y poner los valores reales.
# El archivo .env no se sube al repositorio.

PUERTO=4000

# Base de datos
# En el computador se usan estos cuatro. Si la base de datos esta publicada en
# internet, se usa BD_URL en su lugar y los demas se ignoran.
# BD_URL=postgresql://usuario:clave@servidor:5432/ticketflow
BD_HOST=localhost
BD_PUERTO=5432
BD_NOMBRE=ticketflow
BD_USUARIO=postgres
BD_CONTRASENA=

# Clave con la que se firman los token de sesion.
# En produccion tiene que ser una cadena larga y aleatoria.
JWT_SECRETO=cambiar-esta-clave-por-una-larga-y-aleatoria
JWT_HORAS=8

# De donde se permite llamar a la API (el frontend)
ORIGEN_PERMITIDO=http://localhost:5500

# Correo saliente (Gmail por SMTP)
# La clave NO es la contrasena de Gmail: es una "contrasena de aplicacion" de
# 16 caracteres. Se saca en la cuenta de Google, con la verificacion en dos
# pasos activada: Seguridad > Verificacion en 2 pasos > Contrasenas de
# aplicaciones. Si estas dos quedan vacias, el correo queda apagado y los
# mensajes solo se anotan en la consola.
CORREO_HOST=smtp.gmail.com
CORREO_PUERTO=465
CORREO_USUARIO=
CORREO_CLAVE=
CORREO_DESDE=TicketFlow <tu-cuenta@gmail.com>

# Codigo para recuperar la contrasena
RECUPERACION_MINUTOS=15
RECUPERACION_INTENTOS=5
